<?xml version="1.0" ?>
<robot name="yale_delivery_robot">

  <!-- =========================================================
       YALE DELIVERY ROBOT
       Body: 0.61 x 0.61 x 0.30 m (~2 ft x 2 ft x 1 ft)
       Compatible with Gazebo Harmonic + ROS 2 Jazzy
       Sensors:
         - 16-beam 3D LiDAR (VLP-16 class, ±15° vertical, 25 m range)
         - Forward RGB-D depth camera
         - IMU (200 Hz)
         - Wheel encoders (via DiffDrive)
       ========================================================= -->

  <!-- BASE FOOTPRINT -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.010" rpy="0 0 0"/>
  </joint>

  <!-- BASE LINK: 0.61 x 0.61 x 0.30 cargo body, bottom at base_link z=0 -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry>
        <box size="0.61 0.61 0.30"/>
      </geometry>
      <material name="yale_blue">
        <color rgba="0.05 0.20 0.55 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry>
        <box size="0.61 0.61 0.30"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <mass value="15.0"/>
      <inertia ixx="0.5776" ixy="0" ixz="0"
               iyy="0.5776" iyz="0"
               izz="0.9303"/>
    </inertial>
  </link>

  <!-- LEFT WHEEL: r=0.10, w=0.05, outside body at y=+0.32 -->
  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left_link"/>
    <origin xyz="0.0 0.32 0.09" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="wheel_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.05" radius="0.10"/>
      </geometry>
      <material name="tire"><color rgba="0.12 0.12 0.12 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder length="0.05" radius="0.10"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.001354" ixy="0" ixz="0"
               iyy="0.001354" iyz="0"
               izz="0.0025"/>
    </inertial>
  </link>

  <!-- RIGHT WHEEL -->
  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right_link"/>
    <origin xyz="0.0 -0.32 0.09" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="wheel_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.05" radius="0.10"/>
      </geometry>
      <material name="tire"><color rgba="0.12 0.12 0.12 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder length="0.05" radius="0.10"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.001354" ixy="0" ixz="0"
               iyy="0.001354" iyz="0"
               izz="0.0025"/>
    </inertial>
  </link>

  <!-- CASTER BALLS: support at the two back corners -->
  <joint name="caster_back_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_back_right_link"/>
    <origin xyz="-0.24 -0.22 -0.01" rpy="0 0 0"/>
  </joint>
  <link name="caster_back_right_link">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><sphere radius="0.02"/></geometry>
      <material name="tire"/>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry><sphere radius="0.02"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="8.0e-6" ixy="0" ixz="0" iyy="8.0e-6" iyz="0" izz="8.0e-6"/>
    </inertial>
  </link>

  <joint name="caster_back_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_back_left_link"/>
    <origin xyz="-0.24 0.22 -0.01" rpy="0 0 0"/>
  </joint>
  <link name="caster_back_left_link">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><sphere radius="0.02"/></geometry>
      <material name="tire"/>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry><sphere radius="0.02"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="8.0e-6" ixy="0" ixz="0" iyy="8.0e-6" iyz="0" izz="8.0e-6"/>
    </inertial>
  </link>

  <!-- IMU LINK: center of body, mid-height -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.0 0.0 0.15" rpy="0 0 0"/>
  </joint>
  <link name="imu_link"/>

  <!-- 3D LIDAR: on top of body, 4 cm above body top -->
  <joint name="scan_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_scan"/>
    <origin xyz="0.0 0.0 0.34" rpy="0 0 0"/>
  </joint>
  <link name="base_scan">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.06" radius="0.045"/>
      </geometry>
      <material name="lidar"><color rgba="0.2 0.2 0.2 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder length="0.06" radius="0.045"/></geometry>
    </collision>
    <inertial>
      <mass value="0.114"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- DEPTH CAMERA: front face of body, mid-height -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.305 0.0 0.15" rpy="0 0 0"/>
  </joint>
  <link name="camera_link">
    <visual>
      <origin xyz="0.01 0 0" rpy="0 0 0"/>
      <geometry><box size="0.02 0.10 0.03"/></geometry>
      <material name="cam"><color rgba="0.15 0.15 0.15 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0.01 0 0" rpy="0 0 0"/>
      <geometry><box size="0.02 0.10 0.03"/></geometry>
    </collision>
    <inertial>
      <mass value="0.030"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="camera_rgb_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_rgb_frame"/>
    <origin xyz="0.005 0.018 0.013" rpy="0 0 0"/>
  </joint>
  <link name="camera_rgb_frame"/>

  <joint name="camera_rgb_optical_joint" type="fixed">
    <parent link="camera_rgb_frame"/>
    <child link="camera_rgb_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>
  <link name="camera_rgb_optical_frame"/>

  <joint name="camera_depth_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_depth_frame"/>
    <origin xyz="0.005 0.023 0.013" rpy="0 0 0"/>
  </joint>
  <link name="camera_depth_frame"/>

  <joint name="camera_depth_optical_joint" type="fixed">
    <parent link="camera_depth_frame"/>
    <child link="camera_depth_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>
  <link name="camera_depth_optical_frame"/>

  <!-- =========================================================
       GAZEBO HARMONIC PLUGINS
       ========================================================= -->

  <!-- Differential Drive (wheel_separation = 0.64 m, wheel_radius = 0.10 m) -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>0.64</wheel_separation>
      <wheel_radius>0.10</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <min_acceleration>-1.5</min_acceleration>
      <max_acceleration>1.5</max_acceleration>
    </plugin>
  </gazebo>

  <!-- Joint State Publisher -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <joint_name>wheel_left_joint</joint_name>
      <joint_name>wheel_right_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- 16-beam 3D LiDAR (vertical ±15°, 360 horizontal samples, 10 Hz)
       Publishes:
         gz.msgs.LaserScan        on topic 'scan'        (middle ring)
         gz.msgs.PointCloudPacked on topic 'scan/points' (full cloud) -->
  <gazebo reference="base_scan">
    <sensor name="lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <update_rate>10</update_rate>
      <topic>scan</topic>
      <gz_frame_id>base_scan</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>0.0</min_angle>
            <max_angle>6.28319</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <resolution>1</resolution>
            <min_angle>-0.2617994</min_angle>
            <max_angle>0.2617994</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.15</min>
          <max>25.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
      <visualize>false</visualize>
      <alwaysOn>true</alwaysOn>
    </sensor>
  </gazebo>

  <!-- Depth Camera -->
  <gazebo reference="camera_link">
    <sensor name="depth_camera" type="depth_camera">
      <pose>0 0 0 0 0 0</pose>
      <update_rate>15</update_rate>
      <topic>camera</topic>
      <gz_frame_id>camera_depth_optical_frame</gz_frame_id>
      <camera>
        <horizontal_fov>1.047198</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
      <visualize>false</visualize>
      <alwaysOn>true</alwaysOn>
    </sensor>
  </gazebo>

  <!-- IMU -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <pose>0 0 0 0 0 0</pose>
      <update_rate>200</update_rate>
      <topic>imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>2e-4</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>2e-4</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>2e-4</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>1.7e-2</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>1.7e-2</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>1.7e-2</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- Wheel friction -->
  <gazebo reference="wheel_left_link">
    <mu1>0.9</mu1><mu2>0.9</mu2>
  </gazebo>
  <gazebo reference="wheel_right_link">
    <mu1>0.9</mu1><mu2>0.9</mu2>
  </gazebo>

  <!-- Caster slippery contacts -->
  <gazebo reference="caster_back_right_link">
    <mu1>0.0</mu1><mu2>0.0</mu2>
  </gazebo>
  <gazebo reference="caster_back_left_link">
    <mu1>0.0</mu1><mu2>0.0</mu2>
  </gazebo>

</robot>
