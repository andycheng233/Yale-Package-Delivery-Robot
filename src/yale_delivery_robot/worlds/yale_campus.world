<?xml version="1.0" ?>
<!--
  Yale-Style Campus - Traditional Quad Layout
  ~400m x 400m
  Design inspired by Yale's Old Campus / Cross Campus layout:
    - Enclosed residential quadrangles with central greens
    - Chapel/bell tower as focal point
    - Diagonal pathways cutting through quads
    - Perimeter buildings define quad edges
    - Surrounding street grid (College/High/Chapel/Grove St equivalents)
-->
<sdf version="1.8">
  <world name="yale_campus">

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <light type="directional" name="fill">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>0.35 0.38 0.45 1</diffuse>
      <specular>0 0 0 1</specular>
      <direction>0.5 -0.1 -0.5</direction>
    </light>

    <!-- ===== GROUND (grass) ===== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="c">
          <geometry><plane><normal>0 0 1</normal><size>500 500</size></plane></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>500 500</size></plane></geometry>
          <material><ambient>0.24 0.42 0.17 1</ambient><diffuse>0.27 0.46 0.19 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!--
    ================================================================
    LAYOUT OVERVIEW (looking top-down, x=east, y=north)

                        ELM ST (y=150)
    ============================================================
    ||                                                        ||
    ||   [Kroon]        [Dunham]    [Sterling]   [Beinecke]   ||
    ||                                                        ||
    ||   ==========  NORTH QUAD (central green) =========     ||
    ||   [Branford]    [FOUNTAIN]    [Saybrook]              ||
    Y    ==========                                           G
    O    [Chapel Tower]  CROSS CAMPUS  [Library]              R
    R    ==========                                           O
    K    [Davenport]    [Berkeley]    [Pierson]               V
         ==========  SOUTH QUAD (central green) ==========    E
    S                                                         
    T    [Silliman]    [Ezra Stiles]  [Morse]   [Timothy]     S
    ||                                                        T
    ||                                                        ||
    ============================================================
                      CHAPEL ST (y=-150)
    ================================================================
    -->

    <!-- ===================================================
         STREET NETWORK (perimeter + internal streets)
         ===================================================-->

    <!-- ELM ST (north perimeter, y=150) -->
    <model name="road_elm_st"><static>true</static><link name="link">
      <collision name="c"><geometry><box><size>340 10 0.05</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction><contact><ode><kp>1e8</kp><kd>10.0</kd></ode></contact></surface></collision>
      <visual name="v"><geometry><box><size>340 10 0.05</size></box></geometry>
        <material><ambient>0.20 0.20 0.20 1</ambient><diffuse>0.22 0.22 0.22 1</diffuse></material>
      </visual>
    </link><pose>0 150 0.025 0 0 0</pose></model>
    <model name="stripe_elm"><static>true</static><link name="link">
      <visual name="v"><geometry><box><size>340 0.25 0.01</size></box></geometry>
        <material><ambient>0.95 0.85 0.0 1</ambient><diffuse>0.95 0.85 0.0 1</diffuse></material>
      </visual>
    </link><pose>0 150 0.055 0 0 0</pose></model>
    <model name="sw_elm_s"><static>true</static><link name="link">
      <collision name="c"><geometry><box><size>340 3 0.08</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction><contact><ode><kp>1e8</kp><kd>10.0</kd></ode></contact></surface></collision>
      <visual name="v"><geometry><box><size>340 3 0.08</size></box></geometry>
        <material><ambient>0.76 0.76 0.73 1</ambient><diffuse>0.76 0.76 0.73 1</diffuse></material>
      </visual>
    </link><pose>0 144.5 0.04 0 0 0</pose></model>
    <model name="sw_elm_n"><static>true</static><link name="link">
      <collision name="c"><geometry><box><size>340 3 0.08</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction><contact><ode><kp>1e8</kp><kd>10.0</kd></ode></contact></surface></collision>
      <visual name="v"><geometry><box><size>340 3 0.08</size></box></geometry>
        <material><ambient>0.76 0.76 0.73 1</ambient><diffuse>0.76 0.76 0.73 1</diffuse></material>
      </visual>
    </link><pose>0 155.5 0.04 0 0 0</pose></model>
    <model name="verge_elm_s"><static>true</static><link name="link">
      <visual name="v"><geometry><box><size>340 2 0.01</size></box></geometry>
        <material><ambient>0.22 0.40 0.15 1</ambient><diffuse>0.25 0.44 0.17 1</diffuse></material>
      </visual>
    </link><pose>0 141.5 0.005 0 0 0</pose></model>

    <!-- CHAPEL ST (south perimeter, y=-150) -->
    <model name="road_chapel_st"><static>true</static><link name="link">
      <collision name="c"><geometry><box><size>340 10 0.05</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction><contact><ode><kp>1e8</kp><kd>10.0</kd></ode></contact></surface></collision>
      <visual name="v"><geometry><box><size>340 10 0.05</size></box></geometry>
        <material><ambient>0.20 0.20 0.20 1</ambient><diffuse>0.22 0.22 0.22 1</diffuse></material>
      </visual>
    </link><pose>0 -150 0.025 0 0 0</pose></model>
    <model name="stripe_chapel"><static>true</static><link name="link">
      <visual name="v"><geometry><box><size>340 0.25 0.01</size></box></geometry>
        <material><ambient>0.95 0.85 0.0 1</ambient><diffuse>0.95 0.85 0.0 1</diffuse></material>
      </visual>
    </link><pose>0 -150 0.055 0 0 0</pose></model>
    <model name="sw_chapel_n"><static>true</static><link name="link">
      <collision name="c"><geometry><box><size>340 3 0.08</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction><contact><ode><kp>1e8</kp><kd>10.0</kd></ode></contact></surface></collision>
      <visual name="v"><geometry><box><size>340 3 0.08</size></box></geometry>
        <material><ambient>0.76 0.76 0.73 1</ambient><diffuse>0.76 0.76 0.73 1</diffuse></material>
      </visual>
    </link><pose>0 -144.5 0.04 0 0 0</pose></model>
    <model name="sw_chapel_s"><static>true</static><link name="link">
      <collision name="c"><geometry><box><size>340 3 0.08</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction><contact><ode><kp>1e8</kp><kd>10.0</kd></ode></contact></surface></collision>
      <visual name="v"><geometry><box><size>340 3 0.08</size></box></geometry>
        <material><ambient>0.76 0.76 0.73 1</ambient><diffuse>0.76 0.76 0.73 1</diffuse></material>
      </visual>
    </link><pose>0 -155.5 0.04 0 0 0</pose></model>
    <model name="verge_chapel_n"><static>true</static><link name="link">
      <visual name="v"><geometry><box><size>340 2 0.01</size></box></geometry>
        <material><ambient>0.22 0.40 0.15 1</ambient><diffuse>0.25 0.44 0.17 1</diffuse></material>
      </visual>
    </link><pose>0 -141.5 0.005 0 0 0</pose></model>

    <!-- YORK ST (west perimeter, x=-170) -->
    <model name="road_york_st"><static>true</static><link name="link">
      <collision name="c"><geometry><box><size>9 320 0.05</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction><contact><ode><kp>1e8</kp><kd>10.0</kd></ode></contact></surface></collision>
      <visual name="v"><geometry><box><size>9 320 0.05</size></box></geometry>
        <material><ambient>0.20 0.20 0.20 1</ambient><diffuse>0.22 0.22 0.22 1</diffuse></material>
      </visual>
    </link><pose>-170 0 0.025 0 0 0</pose></model>
    <model name="stripe_york"><static>true</static><link name="link">
      <visual name="v"><geometry><box><size>0.25 320 0.01</size></box></geometry>
        <material><ambient>0.95 0.85 0.0 1</ambient><diffuse>0.95 0.85 0.0 1</diffuse></material>
      </visual>
    </link><pose>-170 0 0.055 0 0 0</pose></model>
    <model name="sw_york_e"><static>true</static><link name="link">
      <collision name="c"><geometry><box><size>3 320 0.08</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction><contact><ode><kp>1e8</kp><kd>10.0</kd></ode></contact></surface></collision>
      <visual name="v"><geometry><box><size>3 320 0.08</size></box></geometry>
        <material><ambient>0.76 0.76 0.73 1</ambient><diffuse>0.76 0.76 0.73 1</diffuse></material>
      </visual>
    </link><pose>-165 0 0.04 0 0 0</pose></model>
    <model name="sw_york_w"><static>true</static><link name="link">
      <collision name="c"><geometry><box><size>3 320 0.08</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction><contact><ode><kp>1e8</kp><kd>10.0</kd></ode></contact></surface></collision>
      <visual name="v"><geometry><box><size>3 320 0.08</size></box></geometry>
        <material><ambient>0.76 0.76 0.73 1</ambient><diffuse>0.76 0.76 0.73 1</diffuse></material>
      </visual>
    </link><pose>-175 0 0.04 0 0 0</pose></model>

    <!-- GROVE ST (east perimeter, x=170) -->
    <model name="road_grove_st"><static>true</static><link name="link">
      <collision name="c"><geometry><box><size>9 320 0.05</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction><contact><ode><kp>1e8</kp><kd>10.0</kd></ode></contact></surface></collision>
      <visual name="v"><geometry><box><size>9 320 0.05</size></box></geometry>
        <material><ambient>0.20 0.20 0.20 1</ambient><diffuse>0.22 0.22 0.22 1</diffuse></material>
      </visual>
    </link><pose>170 0 0.025 0 0 0</pose></model>
    <model name="stripe_grove"><static>true</static><link name="link">
      <visual name="v"><geometry><box><size>0.25 320 0.01</size></box></geometry>
        <material><ambient>0.95 0.85 0.0 1</ambient><diffuse>0.95 0.85 0.0 1</diffuse></material>
      </visual>
    </link><pose>170 0 0.055 0 0 0</pose></model>
    <model name="sw_grove_w"><static>true</static><link name="link">
      <collision name="c"><geometry><box><size>3 320 0.08</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction><contact><ode><kp>1e8</kp><kd>10.0</kd></ode></contact></surface></collision>
      <visual name="v"><geometry><box><size>3 320 0.08</size></box></geometry>
        <material><ambient>0.76 0.76 0.73 1</ambient><diffuse>0.76 0.76 0.73 1</diffuse></material>
      </visual>
    </link><pose>165 0 0.04 0 0 0</pose></model>
    <model name="sw_grove_e"><static>true</static><link name="link">
      <collision name="c"><geometry><box><size>3 320 0.08</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction><contact><ode><kp>1e8</kp><kd>10.0</kd></ode></contact></surface></collision>
      <visual name="v"><geometry><box><size>3 320 0.08</size></box></geometry>
        <material><ambient>0.76 0.76 0.73 1</ambient><diffuse>0.76 0.76 0.73 1</diffuse></material>
      </visual>
    </link><pose>175 0 0.04 0 0 0</pose></model>

    <!-- CROSS CAMPUS ST (middle EW road, y=0) - runs through middle -->
    <model name="road_cross_campus"><static>true</static><link name="link">
      <collision name="c"><geometry><box><size>340 8 0.05</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction><contact><ode><kp>1e8</kp><kd>10.0</kd></ode></contact></surface></collision>
      <visual name="v"><geometry><box><size>340 8 0.05</size></box></geometry>
        <material><ambient>0.20 0.20 0.20 1</ambient><diffuse>0.22 0.22 0.22 1</diffuse></material>
      </visual>
    </link><pose>0 0 0.025 0 0 0</pose></model>
    <model name="stripe_cross"><static>true</static><link name="link">
      <visual name="v"><geometry><box><size>340 0.25 0.01</size></box></geometry>
        <material><ambient>0.95 0.85 0.0 1</ambient><diffuse>0.95 0.85 0.0 1</diffuse></material>
      </visual>
    </link><pose>0 0 0.055 0 0 0</pose></model>
    <model name="sw_cross_n"><static>true</static><link name="link">
      <collision name="c"><geometry><box><size>340 2.5 0.08</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction><contact><ode><kp>1e8</kp><kd>10.0</kd></ode></contact></surface></collision>
      <visual name="v"><geometry><box><size>340 2.5 0.08</size></box></geometry>
        <material><ambient>0.76 0.76 0.73 1</ambient><diffuse>0.76 0.76 0.73 1</diffuse></material>
      </visual>
    </link><pose>0 5.25 0.04 0 0 0</pose></model>
    <model name="sw_cross_s"><static>true</static><link name="link">
      <collision name="c"><geometry><box><size>340 2.5 0.08</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction><contact><ode><kp>1e8</kp><kd>10.0</kd></ode></contact></surface></collision>
      <visual name="v"><geometry><box><size>340 2.5 0.08</size></box></geometry>
        <material><ambient>0.76 0.76 0.73 1</ambient><diffuse>0.76 0.76 0.73 1</diffuse></material>
      </visual>
    </link><pose>0 -5.25 0.04 0 0 0</pose></model>

    <!-- ===================================================
         INTERNAL PATHWAYS (pedestrian only, no roads)
         Brick-colored paths cutting through the quads
         ===================================================-->

    <!-- North Quad pathways: cross pattern -->
    <model name="path_nq_ew"><static>true</static><link name="link">
      <collision name="c"><geometry><box><size>140 3 0.06</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction><contact><ode><kp>1e8</kp><kd>10.0</kd></ode></contact></surface></collision>
      <visual name="v"><geometry><box><size>140 3 0.06</size></box></geometry>
        <material><ambient>0.55 0.35 0.25 1</ambient><diffuse>0.60 0.38 0.28 1</diffuse></material>
      </visual>
    </link><pose>0 80 0.03 0 0 0</pose></model>
    <model name="path_nq_ns"><static>true</static><link name="link">
      <collision name="c"><geometry><box><size>3 80 0.06</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction><contact><ode><kp>1e8</kp><kd>10.0</kd></ode></contact></surface></collision>
      <visual name="v"><geometry><box><size>3 80 0.06</size></box></geometry>
        <material><ambient>0.55 0.35 0.25 1</ambient><diffuse>0.60 0.38 0.28 1</diffuse></material>
      </visual>
    </link><pose>0 80 0.03 0 0 0</pose></model>
    <!-- North Quad diagonal pathways (corner to corner) -->
    <model name="path_nq_diag1"><static>true</static><link name="link">
      <collision name="c"><geometry><box><size>100 2.5 0.06</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction><contact><ode><kp>1e8</kp><kd>10.0</kd></ode></contact></surface></collision>
      <visual name="v"><geometry><box><size>100 2.5 0.06</size></box></geometry>
        <material><ambient>0.55 0.35 0.25 1</ambient><diffuse>0.60 0.38 0.28 1</diffuse></material>
      </visual>
    </link><pose>0 80 0.03 0 0 0.615</pose></model>
    <model name="path_nq_diag2"><static>true</static><link name="link">
      <collision name="c"><geometry><box><size>100 2.5 0.06</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction><contact><ode><kp>1e8</kp><kd>10.0</kd></ode></contact></surface></collision>
      <visual name="v"><geometry><box><size>100 2.5 0.06</size></box></geometry>
        <material><ambient>0.55 0.35 0.25 1</ambient><diffuse>0.60 0.38 0.28 1</diffuse></material>
      </visual>
    </link><pose>0 80 0.03 0 0 -0.615</pose></model>

    <!-- South Quad pathways -->
    <model name="path_sq_ew"><static>true</static><link name="link">
      <collision name="c"><geometry><box><size>140 3 0.06</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction><contact><ode><kp>1e8</kp><kd>10.0</kd></ode></contact></surface></collision>
      <visual name="v"><geometry><box><size>140 3 0.06</size></box></geometry>
        <material><ambient>0.55 0.35 0.25 1</ambient><diffuse>0.60 0.38 0.28 1</diffuse></material>
      </visual>
    </link><pose>0 -80 0.03 0 0 0</pose></model>
    <model name="path_sq_ns"><static>true</static><link name="link">
      <collision name="c"><geometry><box><size>3 80 0.06</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction><contact><ode><kp>1e8</kp><kd>10.0</kd></ode></contact></surface></collision>
      <visual name="v"><geometry><box><size>3 80 0.06</size></box></geometry>
        <material><ambient>0.55 0.35 0.25 1</ambient><diffuse>0.60 0.38 0.28 1</diffuse></material>
      </visual>
    </link><pose>0 -80 0.03 0 0 0</pose></model>
    <model name="path_sq_diag1"><static>true</static><link name="link">
      <collision name="c"><geometry><box><size>100 2.5 0.06</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction><contact><ode><kp>1e8</kp><kd>10.0</kd></ode></contact></surface></collision>
      <visual name="v"><geometry><box><size>100 2.5 0.06</size></box></geometry>
        <material><ambient>0.55 0.35 0.25 1</ambient><diffuse>0.60 0.38 0.28 1</diffuse></material>
      </visual>
    </link><pose>0 -80 0.03 0 0 0.615</pose></model>
    <model name="path_sq_diag2"><static>true</static><link name="link">
      <collision name="c"><geometry><box><size>100 2.5 0.06</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction><contact><ode><kp>1e8</kp><kd>10.0</kd></ode></contact></surface></collision>
      <visual name="v"><geometry><box><size>100 2.5 0.06</size></box></geometry>
        <material><ambient>0.55 0.35 0.25 1</ambient><diffuse>0.60 0.38 0.28 1</diffuse></material>
      </visual>
    </link><pose>0 -80 0.03 0 0 -0.615</pose></model>

    <!-- ===================================================
         CHAPEL / BELL TOWER (focal point, center of campus)
         ===================================================-->
    <model name="chapel_tower"><static>true</static><link name="link">
      <collision name="base_c"><geometry><box><size>14 14 12</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction><contact><ode><kp>1e8</kp><kd>10.0</kd></ode></contact></surface></collision>
      <visual name="base"><geometry><box><size>14 14 12</size></box></geometry>
        <material><ambient>0.70 0.65 0.55 1</ambient><diffuse>0.72 0.67 0.57 1</diffuse></material>
      </visual>
      <!-- Middle tier -->
      <visual name="tier2"><pose>0 0 9 0 0 0</pose>
        <geometry><box><size>10 10 8</size></box></geometry>
        <material><ambient>0.68 0.63 0.53 1</ambient><diffuse>0.70 0.65 0.55 1</diffuse></material>
      </visual>
      <!-- Bell tower -->
      <visual name="tower"><pose>0 0 18 0 0 0</pose>
        <geometry><box><size>7 7 12</size></box></geometry>
        <material><ambient>0.66 0.60 0.48 1</ambient><diffuse>0.68 0.62 0.50 1</diffuse></material>
      </visual>
      <!-- Spire -->
      <visual name="spire"><pose>0 0 28 0 0 0</pose>
        <geometry><box><size>3 3 8</size></box></geometry>
        <material><ambient>0.45 0.40 0.35 1</ambient><diffuse>0.48 0.43 0.37 1</diffuse></material>
      </visual>
      <!-- Peak -->
      <visual name="peak"><pose>0 0 34 0 0 0</pose>
        <geometry><box><size>1 1 4</size></box></geometry>
        <material><ambient>0.30 0.25 0.20 1</ambient><diffuse>0.32 0.27 0.22 1</diffuse></material>
      </visual>
    </link><pose>0 0 6 0 0 0</pose></model>

    <!-- Chapel courtyard (around tower base) -->
    <model name="chapel_plaza"><static>true</static><link name="link">
      <collision name="c"><geometry><box><size>30 30 0.08</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction><contact><ode><kp>1e8</kp><kd>10.0</kd></ode></contact></surface></collision>
      <visual name="v"><geometry><box><size>30 30 0.08</size></box></geometry>
        <material><ambient>0.70 0.65 0.60 1</ambient><diffuse>0.72 0.67 0.62 1</diffuse></material>
      </visual>
    </link><pose>0 0 0.04 0 0 0</pose></model>

    <!-- ===================================================
         BUILDINGS - Yale residential college layout
         All building bases are ~1m elevated from road, set back
         from sidewalks, forming enclosed quads
         ===================================================-->

    <!-- ============ NORTH QUAD BUILDINGS ============ -->
    <!-- Sterling Memorial Library (north face of N quad) -->
    <model name="sterling_library"><static>true</static><link name="link">
      <collision name="c"><geometry><box><size>80 20 15</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction><contact><ode><kp>1e8</kp><kd>10.0</kd></ode></contact></surface></collision>
      <visual name="walls"><geometry><box><size>80 20 15</size></box></geometry>
        <material><ambient>0.70 0.62 0.48 1</ambient><diffuse>0.72 0.64 0.50 1</diffuse></material>
      </visual>
      <visual name="roof"><pose>0 0 8 0 0 0</pose>
